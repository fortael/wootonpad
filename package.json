{
  "name": "wootonpad",
  "version": "0.11.0",
  "private": true,
  "description": "A desktop app for browsing, searching, and managing CLI coding sessions",
  "author": "Zakhar Morozov <tinkly.quill-8p@icloud.com>",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run sign:electron && npm run bundle:codemirror && npm run bundle:vue && electron .",
    "test": "npm run typecheck && node --test --test-timeout=60000 --test-force-exit",
    "typecheck": "tsc --noEmit",
    "electron": "npm run sign:electron && npm run bundle:vue && electron .",
    "dev": "npm run sign:electron && npm run bundle:codemirror && npm run bundle:vue && (vite build --watch & electron .) && wait",
    "bundle:codemirror": "esbuild public/codemirror-setup.js --bundle --outfile=public/codemirror-bundle.js --format=iife --platform=browser --minify",
    "bundle:vue": "vite build",
    "build:landing": "vite build --config vite.landing.config.js && cp build/icon.png docs/icon.png && node scripts/copy-landing-fonts.js",
    "dev:landing": "node scripts/dev-landing.mjs",
    "preview:landing": "node scripts/serve-docs.mjs",
    "generate-icons": "node scripts/generate-icons.js && node scripts/generate-dmg-background.js",
    "build": "npm run bundle:codemirror && npm run bundle:vue && electron-builder",
    "build:mac": "npm run bundle:codemirror && npm run bundle:vue && electron-builder --mac && node scripts/postinstall.js",
    "build:mac:arm64": "npm run bundle:vue && electron-builder --mac --arm64 2>/dev/null; true",
    "build:win": "npm run bundle:codemirror && npm run bundle:vue && electron-builder --win",
    "build:linux": "npm run bundle:codemirror && npm run bundle:vue && electron-builder --linux",
    "release": "npm run bundle:codemirror && npm run bundle:vue && electron-builder --publish always",
    "postinstall": "node scripts/postinstall.js",
    "fonts:generate": "node scripts/generate-brand-fonts.js",
    "sign:electron": "node scripts/sign-dev-electron.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@ddietr/codemirror-themes": "1.5.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@napi-rs/canvas": "1.0.9",
    "@vitejs/plugin-vue": "6.0.9",
    "chokidar": "5.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-static": "1.47.0",
    "marked": "18.0.13",
    "png2icons": "2.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vue": "3.5.43"
  },
  "build": {
    "appId": "ai.doctly.wootonpad",
    "productName": "WootonPad",
    "files": [
      "*.js",
      "workers/**/*",
      "public/**/*",
      "node_modules/**/*",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/Release/obj/**",
      "!node_modules/better-sqlite3/build/Release/test_extension.node",
      "!node_modules/node-pty/src/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/node-pty/build/Release/obj/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.ts",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/spec/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/example/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/.github/**",
      "!node_modules/**/*.md"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "fortael",
      "repo": "wootonpad",
      "releaseType": "release"
    },
    "mac": {
      "identity": "-",
      "protocols": [
        {
          "name": "WootonPad",
          "schemes": [
            "wootonpad"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 170
        },
        {
          "x": 490,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
